<% layout("/layouts/boilerplate") %>

<div class="container mt-4">

<h2 class="mb-4">
 Route Details
</h2>

<div class="card shadow">

<div class="card-body">

<h3>
<%= fromPlace %>
→
<%= toPlace %>
</h3>

<p>
Driver:
<%= route.driver.username %>

<% if(route.driver && route.driver.isVerifiedDriver){ %>

<span class="badge bg-success">
✅ Verified Driver
</span>

<% } %>

</p>


<p>
<i class="bi bi-car-front-fill"></i> Vehicle:
<%= route.vehicleType %>
</p>

<p>
<i class="bi bi-car-front-fill"></i> Vehicle No:
<%= route.vehicleNumber %>
</p>

<p>
<i class="bi bi-telephone-fill"></i> Contact:
<%= route.contactNumber %>
</p>

<p>
<span class="material-symbols-outlined">
airline_seat_recline_extra
</span>
    Available Seats:
<%= route.availableSeats %>
</p>

<p>
<i class="bi bi-currency-rupee"></i> Fare:
₹<%= fare %>
</p>

<p>
<i class="bi bi-clock-fill"></i> Arrival Time:
<%= arrivalTime %>
</p>


<p>

Status:

<% if(route.status === "active"){ %>

<span class="badge bg-success">
Active
</span>

<% } else if(route.status === "stopped"){ %>

<span class="badge bg-danger">
Stopped
</span>

<% } else if(route.status === "waiting"){ %>

<span class="badge bg-secondary">
Waiting
</span>

<% } else if(route.status === "cancelled"){ %>

<span class="badge bg-dark">
Cancelled
</span>

<% } %>

</p>



<hr>

<% if(route.status === "active"){ %>

<h4 class="mb-3">
Reserve Seat
</h4>

<form
action="/routes/<%= route._id %>/book"
method="POST"
>

<input
type="hidden"
name="from"
value="<%= fromPlace %>"

>

<input
type="hidden"
name="to"
value="<%= toPlace %>"

>

<div class="mb-3">

<label>
Passenger Name
</label>

<input
type="text"
name="passengerName"
class="form-control"
required

>

</div>

<div class="mb-3">

<label>
Phone Number
</label>

<input
type="text"
name="phoneNumber"
class="form-control"
required

>

</div>


<div class="mb-3">

<label>
Seats
</label>

<input
type="number"
name="seatsBooked"
id="seatsBooked"
class="form-control"
min="1"
required

>

<div class="mb-3">

    <label class="form-label fw-bold">
        <i class="bi bi-geo-alt-fill"></i>
        Pickup Location
    </label>

    <div class="input-group">

        <input
            type="text"
            name="pickupLocation"
            id="pickupLocation"
            class="form-control"
            placeholder="Enter exact pickup location"
            required
        >

        <a
            href="https://www.google.com/maps"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-primary">

            <i class="bi bi-google"></i>
            Choose on Map

        </a>

    </div>

    <small class="text-muted">
        Open Google Maps, find your exact pickup place,
        then copy the place name/address and paste it here.
    </small>

</div>


<script>

const pickupInput =
    document.getElementById("pickupLocation");

const mapSearchBtn =
    document.getElementById("mapSearchBtn");


pickupInput.addEventListener(
    "input",
    function () {

        const location =
            pickupInput.value.trim();


        if (!location) {

            mapSearchBtn.href = "#";

            mapSearchBtn.classList.add(
                "disabled"
            );

            return;

        }


        const searchLocation =
            encodeURIComponent(
                location + ", Sopore, India"
            );


        mapSearchBtn.href =
            "https://www.google.com/maps/search/?api=1&query="
            + searchLocation;


        mapSearchBtn.classList.remove(
            "disabled"
        );

    }
);

</script>

<p>
Total Fare:
₹<span id="totalFare">0</span>
</p>

<script>

const fare = Number("<%= fare %>");

document
.getElementById("seatsBooked")
.addEventListener(
"input",
function(){

document
.getElementById("totalFare")
.innerText =
fare *
(Number(this.value) || 0);

}
);

</script>

<button
type="submit"
id="bookBtn"
class="btn btn-success">

Book Seat

</button>

</form>

<script>
document.querySelector("form").addEventListener("submit", function () {

    const btn = document.getElementById("bookBtn");

    btn.disabled = true;

    btn.innerHTML = `
    <span class="spinner-border spinner-border-sm"></span>
    Booking...
    `;

});
</script>

<% } else { %>

<div class="alert alert-warning">
Route is not active for booking
</div>

<% } %>

</div>




