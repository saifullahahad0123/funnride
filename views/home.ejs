<% layout("/layouts/boilerplate") %>
<div class="hero-section text-center py-2">

    <h1 class="h4 fw-bold mb-2">
        Book Shared Transport Across India
    </h1>

    <p class="small mb-0">
        Find buses, sumos, taxis, and shared rides easily.
    </p>

</div>



<div class="row justify-content-center mt-3">

   <div class="container mt-5">

<h2 class="mb-4">

<i class="bi bi-search"></i> Search Route

</h2>

<form action="/search-route" method="GET">
    <div class="mb-3">
        <label for="from" class="form-label">From</label>
        <input
            type="text"
            id="from"
            name="from"
            class="form-control"
            placeholder="Enter starting location"
            value="<%= typeof from !== 'undefined' ? from : '' %>"
            required
        >
    </div>

    <div class="mb-3">
        <label for="to" class="form-label">To</label>
        <input
            type="text"
            id="to"
            name="to"
            class="form-control"
            placeholder="Enter destination"
            value="<%= typeof to !== 'undefined' ? to : '' %>"
            required
        >
    </div>

    <button type="submit" class="btn btn-primary">
        Search Routes
    </button>
</form>
</div>  

</div>