<% layout("/layouts/boilerplate") %>

<div class="container">

<h1 class="mb-4">
<i class="bi bi-car-front-fill"></i> Driver Dashboard
</h1>



<div class="row g-3 mb-4">

    <div class="col-6 col-md-3">
        <div class="card shadow h-100 text-center">
            <div class="card-body">
                <h6>Total Routes</h6>
                <h2><%= routes.length %></h2>
            </div>
        </div>
    </div>

    <div class="col-6 col-md-3">
        <div class="card shadow h-100 text-center">
            <div class="card-body">
                <h6>Active Routes</h6>
                <h2>
                    <%= routes.filter(route => route.status === "active").length %>
                </h2>
            </div>
        </div>
    </div>

    <div class="col-6 col-md-3">
        <div class="card shadow h-100 text-center">
            <div class="card-body">
                <h6>Stopped Routes</h6>
                <h2>
                    <%= routes.filter(route => route.status === "stopped").length %>
                </h2>
            </div>
        </div>
    </div>

    <div class="col-6 col-md-3">
        <div class="card shadow h-100 text-center">
            <div class="card-body">
                <h6>Total Earnings</h6>
                <h2>₹<%= totalEarnings || 0 %></h2>
            </div>
        </div>
    </div>

</div>



<div class="mb-4">
<a
href="/routes/new"
class="btn btn-primary"
>
<i class="bi bi-plus-circle-fill"></i> Create New Route
</a>
</div>




<h2 class="mb-3">
My Routes
</h2>

<% if(routes.length === 0){ %>

<div class="alert alert-warning">
No Routes Found
</div>

<% } %>

<div class="row">

<% routes.forEach(route => { %>

<div class="col-lg-4 mb-4">

<div class="card shadow">

<div class="card-body">

<h4>

<%= route.stops && route.stops.length > 0 ? route.stops[0].from : "No Route" %>

→

<%= route.stops && route.stops.length > 0 ? route.stops[route.stops.length-1].to : "No Route" %>

</h4>



<p>
<i class="bi bi-car-front-fill"></i> Vehicle:
<%= route.vehicleType %>
</p>

<p>
<i class="bi bi-car-front-fill"></i> Vehicle No:
<%= route.vehicleNumber %>
</p>

<p>
<i class="bi bi-telephone-fill"></i> Contact:
<%= route.contactNumber %>
</p>

<p>
<span class="material-symbols-outlined">
airline_seat_recline_extra
</span> Seats:
<%= route.availableSeats %> /
<%= route.totalSeats %>
</p>

<p>
<i class="bi bi-clock-fill"></i> Created:
<%= route.createdAt ? route.createdAt.toLocaleString() : "Not Available" %>
</p>

<p class="fw-bold">
Route Segments:
</p>

<% if(route.stops && route.stops.length > 0){ %>

<ul class="list-group mb-3">

<% route.stops.forEach(stop => { %>

<li class="list-group-item">

<i class="bi bi-geo-alt-fill"></i> <%= stop.from %>

→

<%= stop.to %>

|

₹<%= stop.fare %>

|

<i class="bi bi-clock-fill"></i> <%= stop.arrivalTime %>

</li>
<hr>

<% }) %>

</ul>

<% } %>

<p>

Status:

<% if(route.status === "active"){ %>

<span class="badge bg-success">
Active
</span>

<% } else if(route.status === "stopped"){ %>

<span class="badge bg-danger">
Stopped
</span>

<% } else if(route.status === "cancelled"){ %>

<span class="badge bg-dark">
Cancelled
</span>

<% } else { %>

<span class="badge bg-secondary">
Waiting
</span>

<% } %>

</p>




<div class="d-flex flex-wrap gap-2 mt-3">

<a
href="/routes/<%= route._id %>/edit"
class="btn btn-warning btn-sm"
>
<i class="bi bi-pencil-square"></i> Edit
</a>



<a
href="/routes/<%= route._id %>/passengers"
class="btn btn-info btn-sm">

<i class="bi bi-people-fill"></i>

View Passengers

</a>

<% if(route.status === "waiting" || route.status === "stopped"){ %>

<a
href="/routes/<%= route._id %>/start"
class="btn btn-success btn-sm"
>
<i class="bi bi-play-circle-fill"></i> Start
</a>

<% } %>

<% if(route.status==="active"){ %>

<a
href="/routes/<%= route._id %>/complete"
class="btn btn-success btn-sm">

<i class="bi bi-check-circle-fill"></i>

Complete Trip

</a>

<% } %>

<a
href="/routes/<%= route._id %>/cancel"
class="btn btn-secondary btn-sm"
>
<i class="bi bi-x-circle-fill"></i> Cancel
</a>

<a
href="/routes/<%= route._id %>/activate"
class="btn btn-primary btn-sm"
>
<i class="bi bi-arrow-clockwise"></i> Reopen
</a>

<form
action="/routes/<%= route._id %>?_method=DELETE"
method="POST"
class="d-inline"
>

<button
class="btn btn-danger btn-sm"
onclick="return confirm('Delete this route?')"
>
<i class="bi bi-trash-fill"></i> Delete
</button>

</form>

</div>

</div>

</div>

</div>

<% }) %>

</div>


</div>



<!-- ==========================================
     NOTIFICATION SOUND
========================================== -->

<audio
    id="notificationSound"
    preload="auto">
    <source
        src="/sounds/notification.mp3"
        type="audio/mpeg">
</audio>


<!-- ==========================================
     SOCKET.IO
========================================== -->

<script src="/socket.io/socket.io.js"></script>


<script>

document.addEventListener(
    "DOMContentLoaded",
    function () {

        console.log(
            "Driver dashboard loaded"
        );


        // ======================================
        // SOCKET CONNECTION
        // ======================================

        const socket = io();


        socket.on(
            "connect",
            function () {

                console.log(
                    "✅ Socket connected:",
                    socket.id
                );


                // ==================================
                // DRIVER ID
                // ==================================

                const driverId =
                    "<%= currentUser._id %>";


                console.log(
                    "🚗 Driver ID:",
                    driverId
                );


                // Join driver's private room
                socket.emit(
                    "join",
                    driverId
                );


                console.log(
                    "📢 Joining driver room:",
                    driverId
                );

            }
        );


        // ======================================
        // SOUND ELEMENT
        // ======================================

        const sound =
            document.getElementById(
                "notificationSound"
            );


        if (!sound) {

            console.error(
                "❌ notificationSound element not found"
            );

            return;

        }


        sound.volume = 1;


        // ======================================
        // UNLOCK SOUND
        // ======================================

        let soundUnlocked = false;


        async function unlockSound() {

            if (soundUnlocked) {

                return;

            }


            try {

                /*
                 * Play the sound silently once.
                 * This tells Chrome that the user
                 * has interacted with the page.
                 */

                sound.volume = 0;

                await sound.play();

                sound.pause();

                sound.currentTime = 0;

                sound.volume = 1;

                soundUnlocked = true;


                console.log(
                    "🔊 SOUND UNLOCKED"
                );

            }

            catch (error) {

                console.log(
                    "⚠️ Sound not unlocked yet"
                );

            }

        }


        // Any user interaction can unlock audio

        document.addEventListener(
            "click",
            unlockSound
        );


        document.addEventListener(
            "touchstart",
            unlockSound
        );


        document.addEventListener(
            "keydown",
            unlockSound
        );


        // ======================================
        // NEW NOTIFICATION
        // ======================================

        socket.on(
            "newNotification",
            async function (data) {

                console.log(
                    "================================"
                );

                console.log(
                    "🔔 NEW NOTIFICATION RECEIVED"
                );

                console.log(
                    data
                );

                console.log(
                    "================================"
                );


                // ==================================
                // PLAY SOUND
                // ==================================

                try {

                    sound.pause();

                    sound.currentTime = 0;

                    sound.volume = 1;


                    await sound.play();


                    console.log(
                        "🔊🔊🔊 NOTIFICATION SOUND PLAYING"
                    );


                }

                catch (error) {

                    console.error(
                        "❌ SOUND PLAY ERROR:",
                        error
                    );

                }


                // ==================================
                // SHOW NOTIFICATION
                // ==================================

                if (data && data.message) {

                    alert(
                        "🔔 New Booking\n\n" +
                        data.message
                    );

                }
                else {

                    alert(
                        "🔔 New Booking Received"
                    );

                }

            }
        );


        // ======================================
        // SOCKET DISCONNECTED
        // ======================================

        socket.on(
            "disconnect",
            function () {

                console.log(
                    "❌ Socket disconnected"
                );

            }
        );


        // ======================================
        // SOCKET ERROR
        // ======================================

        socket.on(
            "connect_error",
            function (error) {

                console.error(
                    "❌ Socket connection error:",
                    error
                );

            }
        );

    }
);

</script>